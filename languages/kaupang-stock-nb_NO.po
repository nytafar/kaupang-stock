#. translators: %d: minutes after which an unfinished apply can be taken over.
#: includes/Admin/CountSheet.php:203
#, php-format
msgid "This count is being applied. If that was interrupted, Bruk telling can finish it %d minutes after it started. Counting is locked meanwhile."
msgstr "Varetellingen bokføres nå. Ble det avbrutt, kan Bruk telling fullføre den %d minutter etter at bokføringen startet. Tellingen er låst så lenge."

#. translators: %s: local time from which an interrupted apply can be finished.
#: includes/Admin/CountSheet.php:208
#, php-format
msgid "This count is being applied. If that was interrupted, Bruk telling can finish it from %s (reload the page then). Counting is locked meanwhile."
msgstr "Varetellingen bokføres nå. Ble det avbrutt, kan Bruk telling fullføre den fra kl. %s (last inn siden på nytt da). Tellingen er låst så lenge."

#: includes/Admin/CountSheet.php:467
msgid "This line is flagged for recount. Marking it uncounted is recorded on the count. Enter a note (required):"
msgstr "Linjen er flagget for opptelling. At den merkes som ikke talt, føres i varetellingens logg. Skriv et notat (påkrevd):"

#: includes/Admin/CountSheet.php:468
msgid "Some of these lines are flagged for recount. Marking them uncounted is recorded on the count. Enter a note (required):"
msgstr "Noen av linjene er flagget for opptelling. At de merkes som ikke talt, føres i varetellingens logg. Skriv et notat (påkrevd):"

#. translators: %d: number of stock movements an earlier, interrupted apply had posted.
#: includes/Counting/Apply.php:189
#, php-format
msgid "Count applied. An earlier apply had already posted its %d movement and was interrupted; it is now finished and WooCommerce stock is brought up to date. Nothing was posted twice."
msgid_plural "Count applied. An earlier apply had already posted its %d movements and was interrupted; it is now finished and WooCommerce stock is brought up to date. Nothing was posted twice."
msgstr[0] "Varetellingen er bokført. En tidligere bokføring hadde allerede bokført sin %d bevegelse og ble avbrutt; den er nå fullført, og lagerantallet i WooCommerce er oppdatert. Ingenting ble bokført to ganger."
msgstr[1] "Varetellingen er bokført. En tidligere bokføring hadde allerede bokført sine %d bevegelser og ble avbrutt; den er nå fullført, og lagerantallet i WooCommerce er oppdatert. Ingenting ble bokført to ganger."

#. translators: %s: error detail.
#: includes/Counting/Apply.php:236
#, php-format
msgid "The stock movements were posted, but bringing WooCommerce stock up to date failed: %s. Use Bruk telling again to finish; nothing will be posted twice."
msgstr "Lagerbevegelsene ble bokført, men oppdateringen av lagerantallet i WooCommerce feilet: %s. Trykk Bruk telling igjen for å fullføre; ingenting bokføres to ganger."

#. translators: %s: local date and time from which an interrupted apply can be retried.
#: includes/Counting/Apply.php:254
#, php-format
msgid "This count is being applied right now. If that apply was interrupted, Bruk telling can finish it from %s."
msgstr "Varetellingen bokføres akkurat nå. Ble den bokføringen avbrutt, kan Bruk telling fullføre den fra kl. %s."

#: includes/Counting/Apply.php:258
msgid "This count was reopened or cancelled meanwhile. Reload the page to see where it stands."
msgstr "Varetellingen er gjenåpnet eller avbrutt i mellomtiden. Last inn siden på nytt for å se status."

#. translators: %d: minutes.
#: includes/Counting/Apply.php:264
#, php-format
msgid "This count is being applied. If that apply was interrupted, Bruk telling can finish it %d minutes after it started."
msgstr "Varetellingen bokføres nå. Ble den bokføringen avbrutt, kan Bruk telling fullføre den %d minutter etter at den startet."

#: includes/Counting/CountLines.php:118
msgid "This line is flagged for recount. A note is required to mark it uncounted."
msgstr "Linjen er flagget for opptelling. Et notat er påkrevd for å merke den som ikke talt."

#. translators: 1: line id, 2: product label (with location), 3: user display name, 4: the counted quantity that was cleared.
#: includes/Counting/CountLines.php:131
#, php-format
msgid "[uncounted] line #%1$d, %2$s, %3$s: was %4$s"
msgstr "[ikke talt] linje #%1$d, %2$s, %3$s: var %4$s"

#: includes/Counting/CountLines.php:168
msgid "Some of these lines are flagged for recount. A note is required to mark them uncounted."
msgstr "Noen av linjene er flagget for opptelling. Et notat er påkrevd for å merke dem som ikke talt."

#. translators: 1: location name, 2: number of lines, 3: user display name.
#: includes/Counting/CountLines.php:183
#, php-format
msgid "[uncounted] %1$s: %2$d line, %3$s"
msgid_plural "[uncounted] %1$s: %2$d lines, %3$s"
msgstr[0] "[ikke talt] %1$s: %2$d linje, %3$s"
msgstr[1] "[ikke talt] %1$s: %2$d linjer, %3$s"

